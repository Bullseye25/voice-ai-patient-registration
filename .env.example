# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite default with persistent disk storage)
DATABASE_URL=sqlite:///./patients.db

# Voice AI & Telephony Configuration
# Choose your preferred provider (Vapi / Retell / Twilio)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
OPENAI_API_KEY=your_openai_api_key_here

# Public Webhook Base URL (ngrok tunnel or deployed cloud URL)
WEBHOOK_BASE_URL=https://your-ngrok-or-cloud-url.com
